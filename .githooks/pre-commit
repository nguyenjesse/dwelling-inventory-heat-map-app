#!/bin/sh
# Keep the committed standalone HTML files in sync with app/ source.
#
# The three *.html files at the repo root are GENERATED by
# build/build-standalone.py from app/ (+ app/data). Whenever a commit touches
# app/ or build/, this rebuilds them and stages the result so they never drift
# from source — the same drift the CI guard (.github/workflows/ci.yml) enforces.
# Commits that don't touch app//build/ are skipped, so a docs-only commit never
# rewrites the big files just to bump their build timestamp.
#
# Activate once per clone:  git config core.hooksPath .githooks

if git diff --cached --name-only --diff-filter=ACMR | grep -qE '^(app/|build/)'; then
  echo "pre-commit: app/ or build/ changed — rebuilding standalones…"
  if ! python3 build/build-standalone.py; then
    echo "pre-commit: build failed (see above) — commit aborted." >&2
    exit 1
  fi
  git add POC3-Dwelling-Inventory-Map.html \
          POC3-Building-Area-Manager.html \
          Building-Area-Manager.html
fi
